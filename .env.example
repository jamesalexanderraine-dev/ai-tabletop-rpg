# Copy to .env.local for local dev. Never commit real keys.
# In Claude Code on the web and on Vercel, set these in their settings UIs instead.
ANTHROPIC_API_KEY=
# Optional: the DM model when the player hasn't picked one on the Sheet, and for designing archetypes (default: claude-opus-5-5)
DM_MODEL=
# Optional: server saves (Upstash Redis). Without these, games are saved in the browser.
KV_REST_API_URL=
KV_REST_API_TOKEN=
